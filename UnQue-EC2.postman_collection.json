                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"db connected\", () => pm.expect(pm.response.json().db).to.eql(\"connected\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
