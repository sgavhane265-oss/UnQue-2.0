{
  "info": {
    "name": "UnQue - EC2 + DocumentDB demo flow",
    "description": "Runs the 10-step user flow from the assignment against the API on EC2.\n1) Set the collection variable baseUrl to http://<EC2_PUBLIC_IP>:3000\n2) Run the requests top to bottom (folder 0 = one-time setup, folder 1 = the 10 steps).\nDemo times are generated automatically (a random future day) so you can re-run the flow without slot clashes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate demo times once (random future day, UTC) so re-runs never overlap old slots.",
          "if (!pm.collectionVariables.get('t1')) {",
          "  const d = new Date(); d.setUTCDate(d.getUTCDate() + 30 + Math.floor(Math.random() * 300));",
          "  const at = (h, m) => new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), h, m)).toISOString();",
          "  const set = (k, v) => pm.collectionVariables.set(k, v);",
          "  set('slot1Start', at(10, 0)); set('slot1End', at(11, 0)); set('t1', at(10, 30));   // slot for A1 booking (T1)",
          "  set('slot2Start', at(12, 0)); set('slot2End', at(13, 0)); set('t2', at(12, 30));   // slot for A2 booking (T2)",
          "  set('slot3Start', at(14, 0)); set('slot3End', at(15, 0));                          // free slot ...",
          "  set('slot3NewStart', at(16, 0)); set('slot3NewEnd', at(17, 0));                    // ... moved to this timing in step 8",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://YOUR_EC2_PUBLIC_IP:3000"
    },
    {
      "key": "password",
      "value": "Demo@1234"
    },
    {
      "key": "A1Email",
      "value": "student.a1@college.edu"
    },
    {
      "key": "A2Email",
      "value": "student.a2@college.edu"
    },
    {
      "key": "P1Email",
      "value": "prof.p1@college.edu"
    }
  ],
